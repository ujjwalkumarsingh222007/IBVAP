# ==============================================================================
# IBVAP Backend Environment Configuration
# ==============================================================================

# 1. Server Environment & Gateway
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 2. Database Connection (Defaults to local SQLite if unset)
DATABASE_URL=sqlite:///ibvap.db

# 3. Cryptographic Security & JWT Token Auth
# NOTE: Generate a cryptographically strong 256-bit secret in production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# 4. Default Seed Credentials (For first-time setup only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator123
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123

# 5. Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# 6. Maximum Payload Ingestion Limits (in bytes, 5 MB default)
MAX_FRAME_SIZE_BYTES=5242880

# 7. Member 1 Computer Vision
YOLO_MODEL_PATH=yolov8n.pt
CV_CONFIDENCE_THRESHOLD=0.35

# 8. Member 2 License Plate Recognition & OCR
PLATE_MODEL_PATH=../ai/member2_anpr/models/license_plate.pt
PLATE_CONFIDENCE_THRESHOLD=0.25
ANPR_OCR_CONF=0.30
ANPR_OCR_GPU=false
DUPLICATE_SUPPRESSION_WINDOW_SECONDS=10.0

# 9. Unified Threat Intelligence & Correlation Engine
THREAT_CORRELATION_WINDOW_SECONDS=10.0
THREAT_SUPPRESSION_COOLDOWN_SECONDS=10.0
