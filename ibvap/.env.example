# ==============================================================================
# IBVAP Root Environment Configuration Example
# ==============================================================================

# Backend Gateway
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///backend/ibvap.db
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & ANPR Models
YOLO_MODEL_PATH=yolov8n.pt
PLATE_MODEL_PATH=ai/member2_anpr/models/license_plate.pt
PLATE_CONFIDENCE_THRESHOLD=0.25
ANPR_OCR_CONF=0.30
ANPR_OCR_GPU=false

# Threat Correlation
THREAT_CORRELATION_WINDOW_SECONDS=10.0
THREAT_SUPPRESSION_COOLDOWN_SECONDS=10.0
